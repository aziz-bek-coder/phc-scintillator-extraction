# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.pytest_cache/
.ruff_cache/

# Secrets: never committed
.env
.env.*
*.pem
*.key

# Generated data and caches (regenerate from scripts/ or remote jobs)
data/
cache/
*.npz
*.npy
*.pt
*.h5

# Remote-job artifacts are downloaded to results/<job>/<run-id>/ and never committed.
# Small summaries (results/*.json at the top level) and final figures (docs/figures/)
# are committed.
results/*/
out/
chunks/
resume/
final/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
